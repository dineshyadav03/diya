# --- Secrets / local TLS ---
# Local TLS certificates (configured with DIYA_SSL_CERT/DIYA_SSL_KEY or auto-discovered)
*.pem
*.key
.env
.env.*
# The API access token's hash (Diya creates it), and a saved copy of the token if you keep one
diya_token.hash
diya_token.txt

# --- Personal data and runtime state (Diya creates these as it runs) ---
diya.db
backups/
user_profile.txt
dream_state.json
dream_log.txt
dream_pending.jsonl
watcher_state.json
watcher_log.txt
notify_log.txt
proactive_context.txt
connector_tokens/
# Pages Diya builds from your notes (diya_knowledge.py): your own sentences, grouped by name
/knowledge/
# What diya_advisor.py writes: a report and patches that can quote your own messages, and the messages you add
/advisor/
# The MCP servers you chose and the tools you approved (diya_mcp.py): commands and environment that are yours
/mcp_servers.json
connectors_log.txt
# diya_run.py: the API's and the UI's logs, and the notes it leaves for --status and --stop (they go in the data folder when there is one)
/logs/
diya_run.json
diya_run.stop
# The Telegram bot token (diya_telegram.py --set-token) and the web push key pair (diya_push.py): secrets, never in git
telegram.token
push_vapid.json

# --- Dependencies and build output ---
node_modules/
.next/
__pycache__/
*.pyc
*.egg-info/

# --- Editor / OS / tooling ---
.DS_Store
.claude/settings.local.json

# --- Test / tool caches ---
.pytest_cache/
.ruff_cache/

# --- Personal working notes (kept locally, never published) ---
CLAUDE.md
# Your own playbooks (diya_playbooks.py): steps you wrote for a kind of request; the examples are in sample_playbooks/
/playbooks/

# What diya_export.py writes: your chats, memory and tasks as plain files (docs/EXPORT.md)
/exports/
diya-export-*/
